{
  "name": "hello-office",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Word、PowerPoint、Excel 与日常办公协作的中文手册和练习台",
  "engines": { "node": "^20.19.0 || >=22.16.0" },
  "scripts": {
    "docs:dev": "vitepress dev docs --host 127.0.0.1 --port 5179 --strictPort",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --host 127.0.0.1 --port 5179 --strictPort",
    "check:content": "node scripts/check-content.mjs",
    "test:office": "node --test tests/office-tools.test.mjs",
    "check": "npm run check:content"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "vite": "6.4.3",
    "vitepress": "1.6.4",
    "vue": "^3.4.0"
  },
  "overrides": { "vite": "6.4.3" }
}
